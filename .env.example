# Copy this file to .env and add your own values.
# Never send API keys in chat or put them in public/.

PORT=8787
ASSISTANT_NAME=JARVIS
OWNER_NAME=Isreal
MAKER_NAME=Isrealyte

# LLM: choose groq or xai
LLM_PROVIDER=groq

# GroqCloud
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# xAI/Grok alternative
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Text-to-speech: piper is free and local; fish is optional cloud TTS
TTS_PROVIDER=kokoro
KOKORO_MODEL=onnx-community/Kokoro-82M-ONNX
KOKORO_VOICE=af_heart
KOKORO_DTYPE=q8
KOKORO_DEVICE=cpu
PIPER_PYTHON=.piper-env/Scripts/python.exe
PIPER_MODEL=en_US-lessac-medium
# 0.75 is faster speech; 1.0 is the normal Piper pace.
PIPER_SPEED=0.75
PIPER_DATA_DIR=voices

# Optional Fish Audio fallback/provider
FISH_API_KEY=replace_with_fish_audio_key
FISH_MODEL=s2.1-pro-free
FISH_REFERENCE_ID=

# Speech recognition is browser-based in this first build.
# Optional server ASR later: groq whisper-large-v3-turbo
STT_PROVIDER=browser
GROQ_STT_MODEL=whisper-large-v3-turbo

# WhatsApp Business Cloud API. Do not use unofficial personal-account automation.
META_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change_this_webhook_token

# Google Gmail + Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/integrations/google/callback

# Microsoft Outlook + Calendar OAuth (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8787/integrations/microsoft/callback

# Android ADB (optional; leave blank to use adb from PATH)
ADB_PATH=
ANDROID_DEVICE_SERIAL=
